# Public URL of the deployed site, used for canonical URLs, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Optional: Google AdSense. Ads render only on content pages, never in the editor or PDFs.
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-0000000000000000
# NEXT_PUBLIC_ADSENSE_SLOT=0000000000

# Optional: Google Analytics 4 measurement ID. Only anonymous page views and events
# (invoice_started, template_selected, pdf_downloaded, invoice_printed) are sent — never invoice contents.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
